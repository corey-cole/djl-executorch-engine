.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Ignore Gradle build output directory
build

# Ignore Kotlin plugin data
.kotlin

# Native QA / bench outputs (container-produced)
native/bench/
native/bench-results/
native/asan/
native/ubsan/
native/qa_noasan/

src/main/resources/native/**/*.so
src/main/resources/native/**/*.dylib
src/main/resources/native/**/*.dll
src/main/resources/native/**/licenses/
# Versioned sonames too: the *.so pattern above does NOT match libopenvino.so.2541 or libtbb.so.12,
# so without this the staged OpenVINO bundle is untracked-but-not-ignored and a `git add -A` commits
# ~70 MB of binaries.
src/main/resources/native/**/*.so.*
# The whole staged OpenVINO bundle, which also carries non-library files (BUILDINFO, MANIFEST) that
# no extension pattern would catch. Staged by native/build.sh from the hash-pinned tarball and
# republished into the openvino jar; never a source artifact.
# NOTE: this is src/MAIN/resources. The committed test fixture at src/test/resources/models/openvino/
# is a different path and stays tracked.
src/main/resources/native/**/openvino/
*.rpm
bin/
et-cmake-out/
# Eclipse/JDT per-project settings, generated by the IDE in the root and in example/.
.settings/
